# ================================
# VARIABLES DE ENTORNO - DeteccionOralAPI
# Copiar este archivo como .env y completar los valores
# ================================

# Base de datos (PostgreSQL en producción, SQLite por defecto en desarrollo)
DATABASE_URL=postgresql://api_user:api_password@db:5432/deteccion_oral_db

# Configuración de la API
API_HOST=0.0.0.0
API_PORT=8000

# Seguridad (opcional - si se implementa JWT en el futuro)
# SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria

# CORS - Orígenes permitidos (separados por coma)
# ALLOWED_ORIGINS=http://localhost:3000,https://tu-dominio.com
